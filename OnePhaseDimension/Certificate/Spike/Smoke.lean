/-- Decode, canonicalize and pack a table row. -/
def rowKey (r : ℕ × ℕ × ℕ × ℤ) : ℕ × ℤ :=
  let m := (decodeWord r.1 (wordDigits r.2.1 r.2.2.1)).canonPack
  (m.2, m.1 * r.2.2.2)

